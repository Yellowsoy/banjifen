{
  "name": "banjifen-clone",
  "version": "1.0.0",
  "private": true,
  "description": "班级积分管理 - 全栈复刻版（Node.js + Express + SQLite/sql.js + 原生前端）",
  "license": "Apache-2.0",
  "author": "Yellowsoy (banjifen contributors)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yellowsoy/banjifen.git"
  },
  "homepage": "https://github.com/Yellowsoy/banjifen",
  "bugs": {
    "url": "https://github.com/Yellowsoy/banjifen/issues"
  },
  "keywords": [
    "education",
    "class-management",
    "points",
    "school",
    "vanilla-js",
    "edgeone"
  ],
  "main": "server/src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "seed": "node server/src/seed.js",
    "test": "node server/test/smoke.test.js",
    "build:edgeone": "node scripts/gen-inline.js && node scripts/build-edgeone.js",
    "deploy:edgeone": "npm run build:edgeone && edgeone pages deploy deploy/edgeone-dist -n banjifen -t $EDGEONE_TOKEN"
  },
  "dependencies": {
    "@edgeone/pages-blob": "^0.0.18",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "sql.js": "^1.15.1"
  }
}
