# ===== 服务端 =====
PORT=3000
NODE_ENV=development

# ===== 安全 =====
# JWT 签名密钥，必须 >= 32 字符（生产环境请务必更换）
JWT_SECRET=please-change-me-to-a-32-chars-random-string
ACCESS_TOKEN_TTL=1800
REFRESH_TOKEN_TTL=1209600
CORS_ORIGIN=

# ===== 数据 =====
DB_FILE=data/banjifen.sqlite
UPLOAD_DIR=data/uploads

# ===== 初始化种子数据（首次启动创建，已存在则跳过）=====
# 超级管理员：管理全部班级、账号、密码、手机号与归属关系
SUPER_USERNAME=admin
SUPER_PASSWORD=admin123456
# 演示班级的班主任账号
DEMO_OWNER_USERNAME=123456
DEMO_OWNER_PASSWORD=123456
